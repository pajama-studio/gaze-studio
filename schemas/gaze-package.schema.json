{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pajama-studio/gaze-studio/schemas/gaze-package.schema.json",
  "title": "Gaze Package 0.1.0 manifest",
  "type": "object",
  "required": [
    "format",
    "version",
    "coordinateSystem",
    "timeUnit",
    "clockExtrapolation",
    "recording",
    "files"
  ],
  "properties": {
    "format": {
      "const": "gaze-package"
    },
    "version": {
      "const": "0.1.0"
    },
    "coordinateSystem": {
      "const": "stimulus-pixels-top-left"
    },
    "timeUnit": {
      "const": "microseconds"
    },
    "clockExtrapolation": {
      "const": "linear"
    },
    "recording": {
      "type": "object",
      "required": [
        "id",
        "title",
        "description",
        "width",
        "height",
        "duration",
        "mediaType",
        "mediaName",
        "mediaUrl",
        "anchors",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "duration": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "mediaType": {
          "enum": ["video", "image"]
        },
        "mediaName": {
          "type": "string"
        },
        "mediaUrl": {
          "type": "string",
          "pattern": "^media/"
        },
        "recordedEye": {
          "enum": ["left", "right", "cyclopean"]
        },
        "anchors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["gaze", "media"],
            "properties": {
              "gaze": {
                "type": "integer"
              },
              "media": {
                "type": "integer"
              }
            }
          }
        },
        "source": {
          "type": "object",
          "required": ["license", "synthetic"],
          "properties": {
            "license": {
              "type": "string"
            },
            "synthetic": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "rawSources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path", "type"],
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      }
    }
  }
}
