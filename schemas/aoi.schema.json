{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pajama-studio/gaze-studio/schemas/aoi.schema.json",
  "title": "Gaze Studio AOI 0.1",
  "type": "object",
  "required": [
    "id",
    "name",
    "shape",
    "color",
    "start",
    "end",
    "keyframes",
    "source",
    "accepted"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string"
    },
    "shape": {
      "enum": ["rectangle", "ellipse", "polygon"]
    },
    "color": {
      "type": "string"
    },
    "start": {
      "type": "integer"
    },
    "end": {
      "type": "integer"
    },
    "keyframes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["t", "points"],
        "properties": {
          "t": {
            "type": "integer"
          },
          "points": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "source": {
      "enum": ["manual", "model", "import"]
    },
    "accepted": {
      "type": "boolean"
    },
    "model": {
      "type": "string"
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "shape": {
            "const": "polygon"
          }
        }
      },
      "then": {
        "properties": {
          "keyframes": {
            "items": {
              "properties": {
                "points": {
                  "minItems": 3
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "keyframes": {
            "items": {
              "properties": {
                "points": {
                  "maxItems": 2
                }
              }
            }
          }
        }
      }
    }
  ]
}
